<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude Room SQLite database containing private notification history and content -->
        <exclude domain="database" path="." />
        <exclude domain="database" path="notification_analyzer_db" />
        <exclude domain="root" path="databases" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive notification database from device-to-device transfers -->
        <exclude domain="database" path="." />
        <exclude domain="database" path="notification_analyzer_db" />
    </device-transfer>
</data-extraction-rules>
